<view class="page">
  <view class="topline">
    <view>
      <view class="title">文章管理</view>
      <view class="muted">公开状态和草稿都会显示</view>
    </view>
    <button class="mini-button" bindtap="settings">设置</button>
  </view>
  <view wx:if="{{loading}}" class="muted">加载中...</view>
  <view wx:elif="{{articles.length}}">
    <view class="article-row panel" wx:for="{{articles}}" wx:key="id" data-id="{{item.id}}" bindtap="open">
      <view class="article-main">
        <view class="article-title">{{item.title}}</view>
        <view class="muted">{{item.category}} · {{item.slug}}</view>
      </view>
      <text class="status {{item.published ? '' : 'draft'}}">{{item.published ? '公开' : '草稿'}}</text>
    </view>
  </view>
  <view wx:else class="muted">暂无文章</view>
  <view wx:if="{{message}}" class="message">{{message}}</view>
  <button class="primary" bindtap="create">新建文章</button>
</view>
