<view class="page">
  <view class="panel">
    <view class="field">
      <text class="field-label">API 地址</text>
      <input class="input" value="{{apiBase}}" bindinput="input" placeholder="https://co11ap5e.site/api" />
    </view>
    <button class="primary" bindtap="save">保存地址</button>
    <button class="secondary danger" bindtap="logout">退出登录</button>
    <view wx:if="{{message}}" class="message">{{message}}</view>
  </view>
</view>
