.topline {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.mini-button {
  min-width: 120rpx;
  min-height: 64rpx;
  padding: 0 20rpx;
  border: 1rpx solid #d1d9e0;
  border-radius: 12rpx;
  background: #ffffff;
  font-size: 26rpx;
}

.article-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 18rpx;
}

.article-main {
  min-width: 0;
}

.article-title {
  overflow: hidden;
  font-size: 31rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status {
  display: inline-flex;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #dafbe1;
  color: #1a7f37;
  font-size: 24rpx;
  font-weight: 700;
}

.status.draft {
  background: #fff8c5;
  color: #9a6700;
}
