<view class="page">
  <view class="panel">
    <view class="title">Cls 管理台</view>
    <view class="muted">个人网站内容管理</view>
    <view class="field">
      <text class="field-label">用户名</text>
      <input class="input" data-field="username" value="{{username}}" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="field-label">密码</text>
      <input class="input" data-field="password" type="password" value="{{password}}" bindinput="onInput" />
    </view>
    <button class="primary" loading="{{loading}}" bindtap="submit">登录</button>
    <view wx:if="{{message}}" class="message">{{message}}</view>
  </view>
  <button class="secondary" bindtap="goSettings">服务器设置</button>
</view>
