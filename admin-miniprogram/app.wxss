page {
  min-height: 100%;
  background: #f6f8fa;
  color: #1f2328;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.page {
  padding: 28rpx;
}

.panel {
  padding: 28rpx;
  background: #ffffff;
  border: 1rpx solid #d1d9e0;
  border-radius: 16rpx;
}

.title {
  font-size: 42rpx;
  font-weight: 700;
}

.muted {
  color: #59636e;
  font-size: 26rpx;
}

.primary,
.secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  margin-top: 28rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.primary {
  background: #1f883d;
  color: #ffffff;
}

.secondary {
  border: 1rpx solid #d1d9e0;
  background: #ffffff;
  color: #1f2328;
}

.danger {
  color: #922f1f;
}

.input,
.textarea {
  box-sizing: border-box;
  width: 100%;
  padding: 0 22rpx;
  border: 1rpx solid #d1d9e0;
  border-radius: 12rpx;
  background: #ffffff;
}

.input {
  min-height: 84rpx;
}

.textarea {
  min-height: 280rpx;
  padding-top: 22rpx;
  padding-bottom: 22rpx;
  line-height: 1.6;
}

.field {
  display: grid;
  gap: 14rpx;
  margin-top: 24rpx;
}

.field-label {
  color: #59636e;
  font-size: 25rpx;
  font-weight: 600;
}

.message {
  margin-top: 18rpx;
  color: #922f1f;
  font-size: 25rpx;
}
